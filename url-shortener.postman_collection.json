{
  "info": {
    "name": "VYSON M2A1 - URL Shortener",
    "description": "POST /shorten and GET /redirect?code={code}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "POST /shorten",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://nodejs.org/api/sqlite.html\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/shorten", "host": ["{{baseUrl}}"], "path": ["shorten"] }
      }
    },
    {
      "name": "GET /redirect?code=mmt",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/redirect?code=mmt",
          "host": ["{{baseUrl}}"],
          "path": ["redirect"],
          "query": [{ "key": "code", "value": "mmt" }]
        }
      }
    },
    {
      "name": "GET /stats",
      "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/stats", "host": ["{{baseUrl}}"], "path": ["stats"] } }
    },
    {
      "name": "GET /health",
      "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } }
    },
    {
      "name": "Error - invalid url (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"url\": \"not a url\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/shorten", "host": ["{{baseUrl}}"], "path": ["shorten"] }
      }
    },
    {
      "name": "Error - unknown code (404)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/redirect?code=doesnotexist",
          "host": ["{{baseUrl}}"],
          "path": ["redirect"],
          "query": [{ "key": "code", "value": "doesnotexist" }]
        }
      }
    }
  ]
}
